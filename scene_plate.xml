<mujoco model="Panda cube-to-plate scene">
  <!-- Keep the original scene intact for existing datasets and replays. -->
  <include file="scene.xml"/>
  <worldbody>
    <!-- A fixed plate resting on the 0.25 m table. Its position is randomized
         at reset. The blue border makes the destination visible in RGB. -->
    <body name="plate" pos="0.55 0.17 0.254">
      <geom name="plate_base" type="cylinder" size="0.07 0.004"
        rgba="0.12 0.35 0.9 1" friction="1 0.005 0.0001"/>
      <geom name="plate_surface" type="cylinder" pos="0 0 0.004"
        size="0.061 0.001" rgba="0.78 0.88 1 1" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>
