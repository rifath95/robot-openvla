<mujoco model="Phase 1 Panda scene">
  <include file="mujoco_menagerie/franka_emika_panda/panda.xml"/>
  <!-- Mesh paths are resolved relative to this scene file. -->
  <compiler meshdir="mujoco_menagerie/franka_emika_panda/assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="120" elevation="-25"/>
  </visual>

  <asset>
    <texture name="floor_texture" type="2d" builtin="checker"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="300" height="300"/>
    <material name="floor_material" texture="floor_texture" texrepeat="5 5" texuniform="true"/>
  </asset>

  <worldbody>
    <light pos="0.5 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.05" material="floor_material"/>

    <!-- Fixed RGB camera looking toward the robot workspace. -->
    <camera name="workspace_camera" pos="1.25 -1.15 0.95"
      xyaxes="0.676 0.737 0 -0.339 0.311 0.888" fovy="50"/>

    <!-- Box sizes are half extents, in metres. Table top height: 0.25 m. -->
    <body name="table" pos="0.55 0 0">
      <geom name="table_top" type="box" pos="0 0 0.225" size="0.25 0.3 0.025"
        rgba="0.55 0.38 0.22 1"/>
      <geom name="table_leg_1" type="box" pos="-0.21 -0.26 0.1" size="0.025 0.025 0.1" rgba="0.3 0.3 0.3 1"/>
      <geom name="table_leg_2" type="box" pos="-0.21 0.26 0.1" size="0.025 0.025 0.1" rgba="0.3 0.3 0.3 1"/>
      <geom name="table_leg_3" type="box" pos="0.21 -0.26 0.1" size="0.025 0.025 0.1" rgba="0.3 0.3 0.3 1"/>
      <geom name="table_leg_4" type="box" pos="0.21 0.26 0.1" size="0.025 0.025 0.1" rgba="0.3 0.3 0.3 1"/>
    </body>

    <!-- A 4 cm cube with a free joint can translate and rotate. -->
    <body name="cube" pos="0.55 0 0.271">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.05"
        rgba="0.85 0.15 0.1 1" friction="1 0.005 0.0001"/>
    </body>
  </worldbody>

  <!-- Panda home pose plus cube position and quaternion. -->
  <keyframe>
    <key name="scene_home"
      qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04 0.55 0 0.271 1 0 0 0"
      ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
