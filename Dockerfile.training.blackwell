# Blackwell candidate. CUDA 13.0 libraries come from the PyTorch wheels.
# Reuse RunPod SSH startup; the host supplies the NVIDIA driver.
FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
COPY requirements-openvla-blackwell.txt requirements-dataset.txt requirements-training-blackwell.txt /opt/requirements/
RUN python3.11 -m venv /opt/openvla \
    && /opt/openvla/bin/python -m pip install --no-cache-dir torch==2.14.1 torchvision==0.29.1 --index-url https://download.pytorch.org/whl/cu130 \
    && /opt/openvla/bin/python -m pip install --no-cache-dir -r /opt/requirements/requirements-training-blackwell.txt \
    && /opt/openvla/bin/python -m pip check
COPY training/fetch_upstream.py /opt/training/fetch_upstream.py
COPY training/upstream /opt/training/upstream
RUN /opt/openvla/bin/python /opt/training/fetch_upstream.py --destination /opt/openvla-source
# Model weights and datasets live on the attached volume, not in this image.
# Retain the base image's RunPod SSH startup and configure TCP port 22.
COPY training/check_training_stack.py /opt/training/check_training_stack.py
RUN /opt/openvla/bin/python /opt/training/check_training_stack.py --device cpu --expect-blackwell-stack --output /opt/training/build_stack_check.json
ENV OPENVLA_TRAINING_STACK=blackwell
